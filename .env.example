# GEMINI_API_KEY: Optional for AI Studio runtime
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL of the deployed application (e.g. https://shu-brend.onrender.com)
APP_URL="https://shu-brend.onrender.com"

# Render Server Port (Render sets this dynamically, defaults to 3000 locally)
PORT=3000

# Environment mode ('production' on Render)
NODE_ENV="production"

# --- TELEGRAM BOT INTEGRATION ---
# Your Telegram Bot Token obtained from @BotFather
TELEGRAM_BOT_TOKEN=""

# Target Chat ID (Admin personal chat ID or Group Chat ID with -100...)
TELEGRAM_CHAT_ID=""

# --- ADMIN SECURITY & AUTHENTICATION ---
# Default Admin username (changeable in Admin Panel)
ADMIN_USERNAME="admin"

# Default Admin password (changeable in Admin Panel)
ADMIN_PASSWORD="admin12345678"

# Server Secret Key (used for AES-256-GCM encryption key derivation)
# Provide a random string of at least 32 characters
SERVER_SECRET="shu_brend_super_secret_encryption_key_2025"

# --- PERSISTENT STORAGE (RENDER DISK) ---
# If using a Render Persistent Disk (e.g., Mount Path: /var/data), configure:
# DATA_DIR="/var/data"
# UPLOADS_DIR="/var/data/uploads"
DATA_DIR="./data"
UPLOADS_DIR="./public/uploads"

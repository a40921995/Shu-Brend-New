# ========================================================
# SHU BREND — PRODUCTION & ENVIRONMENT VARIABLES TEMPLATE
# ========================================================

# Render Web Service Port (Render sets this dynamically, defaults to 3000 locally)
PORT=3000

# Environment mode ('production' on Render)
NODE_ENV=production

# Public URL of the deployed application (e.g. https://shu-brend.onrender.com)
APP_URL=https://shu-brend.onrender.com

# --- ADMIN CREDENTIALS ---
# Super Admin login credentials
ADMIN_USERNAME=admin.1212
ADMIN_PASSWORD=shubrend.2026

# Optional: Fixed Master Recovery Key (Format: SHU-RCV-XXXX-XXXX-XXXX)
ADMIN_RECOVERY_KEY=

# --- ENCRYPTION & DATA SECURITY ---
# Server Secret Key (used for AES-256-GCM encryption of sensitive tokens like Telegram & BILLZ)
# Provide a random string of at least 32 characters in production
SERVER_SECRET=shu_brend_ultra_secure_server_secret_2026_xyz

# --- TELEGRAM BOT INTEGRATION ---
# Your Telegram Bot Token obtained from @BotFather
TELEGRAM_BOT_TOKEN=

# Target Chat ID (Admin personal chat ID or Group Chat ID with -100...)
TELEGRAM_CHAT_ID=

# --- BILLZ POS & INVENTORY INTEGRATION ---
# BILLZ API URL (Default: https://api-admin.billz.ai)
BILLZ_API_URL=https://api-admin.billz.ai
BILLZ_API_KEY=
BILLZ_PLATFORM_ID=

# --- PERSISTENT STORAGE (RENDER DISK MOUNT) ---
# If using a Render Persistent Disk (e.g., Mount Path: /var/data), configure:
# DATA_DIR=/var/data
# UPLOADS_DIR=/var/data/uploads
DATA_DIR=./data
UPLOADS_DIR=./public/uploads
